# Public HTTPS endpoints handled by the deployment ingress/reverse proxy.
NEVMA_PUBLIC_ISSUER=https://identity.example.com/
NEVMA_APP_ORIGIN=https://app.example.com
IDENTITY_HTTP_PORT=8081
GATEWAY_HTTP_PORT=8080

# Database and broker secrets. Generate independent random values.
POSTGRES_ADMIN_PASSWORD=replace-with-a-long-random-value
NEVMA_IDENTITY_DB_PASSWORD=replace-with-a-long-random-value
NEVMA_PLANNING_DB_PASSWORD=replace-with-a-long-random-value
NEVMA_MESSAGING_DB_PASSWORD=replace-with-a-long-random-value
NEVMA_NOTIFICATIONS_DB_PASSWORD=replace-with-a-long-random-value
NEVMA_FILES_DB_PASSWORD=replace-with-a-long-random-value
NEVMA_COMMANDS_DB_PASSWORD=replace-with-a-long-random-value
RABBITMQ_DEFAULT_USER=nevma
RABBITMQ_DEFAULT_PASS=replace-with-a-long-random-value
REDIS_PASSWORD=replace-with-a-long-random-value

# Read-only directory containing signing.pfx, encryption.pfx, and data-protection.pfx.
IDENTITY_CERTIFICATES_PATH=/secure/nevma/certificates
IDENTITY_SIGNING_CERTIFICATE_PASSWORD=replace-with-a-long-random-value
IDENTITY_ENCRYPTION_CERTIFICATE_PASSWORD=replace-with-a-long-random-value
DATA_PROTECTION_CERTIFICATE_PASSWORD=replace-with-a-long-random-value

# Optional SMTP delivery for account recovery and email confirmation.
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# Optional Firebase push delivery. Use workload identity or mount ADC credentials in an override.
PUSH_DELIVERY_ENABLED=false
FIREBASE_PROJECT_ID=

# Local encrypted volume is the fallback. Set S3 for managed private object storage.
FILE_STORAGE_PROVIDER=Local
S3_BUCKET_NAME=
S3_SERVICE_URL=
S3_REGION=eu-central-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional provider-neutral AI and speech gateways.
COMMAND_AI_ENABLED=false
COMMAND_AI_ENDPOINT=
COMMAND_AI_API_KEY=
SPEECH_TO_TEXT_ENABLED=false
SPEECH_TO_TEXT_ENDPOINT=
SPEECH_TO_TEXT_API_KEY=
